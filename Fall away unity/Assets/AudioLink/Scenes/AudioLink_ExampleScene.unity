TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1252250244}
  m_Text: "_AudioTexture is a globally broadcast texture \r\nwhich can be picked
    up by shaders on avatars. \r\nIt is a mirror of the local RenderTexture to \rthe
    \nleft. This can be toggled off if \rperformance is \nan issue.\n\nThe above
    shader can be applied to an avatar\nand will pick up the _AudioTexture if the
    world\nhas the AudioLink Prefab installed."
  m_OffsetZ: 0
  m_CharacterSize: 0.5
  m_LineSpacing: 1.3
